<!--
  Add this block inside your /var/ossec/etc/ossec.conf
  under the <ossec_config> root element.

  <level>7</level> means only alerts with severity level 7 or above
  will be forwarded to the OpenAI integration script.
  Adjust as needed (lower = more alerts, higher = fewer/critical only).
-->

<integration>
  <name>custom-openai</name>
  <level>7</level>
  <alert_format>json</alert_format>
</integration>
